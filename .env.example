ENV=development
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_VISION=qwen3.7-plus
QWEN_MODEL_CHAT=qwen3.7-plus
QWEN_MODEL_CLASSIFIER=qwen3.7-flash
QWEN_MODEL_TUTOR=qwen3.7-plus
QWEN_MODEL_SOLVER=qwen3.7-plus
QWEN_MODEL_VERIFIER=qwen3.7-plus
QWEN_MODEL_HARD_FALLBACK=qwen3.8-max
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/signaltutor
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=.var/uploads
LEARNING_STORE_PATH=.var/learning.json
ACCOUNT_STORE_PATH=.var/accounts.json
KNOWLEDGE_STORE_PATH=.var/knowledge.json
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-different-long-random-key
ACCESS_TOKEN_TTL_SECONDS=604800
MAX_IMAGE_BYTES=10485760
VISION_CONFIDENCE_THRESHOLD=0.85
MAX_SOLVER_RETRIES=1
MODEL_REQUEST_TIMEOUT_SECONDS=60
ENABLE_HARD_MODEL_FALLBACK=true
AGENTS_DISABLE_TRACING=1
USE_FAKE_MODELS=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
